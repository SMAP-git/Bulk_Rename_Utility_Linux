pkgname=bulk-rename-utility
pkgver="${VERSION:-1.0.0}"
pkgrel=1
pkgdesc='Preview-first batch file renaming utility'
arch=('x86_64')
url='https://github.com/SMAP-git/Bulk_Rename_Utility_Linux'
license=('Unlicense')
depends=('fontconfig' 'libice' 'libsm' 'libx11' 'libxext' 'libxrender' 'libxrandr' 'libxcursor' 'libxi')
makedepends=('dotnet-sdk')
source=("Bulk_Rename_Utility_Linux-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/Bulk_Rename_Utility_Linux"
    dotnet publish src/BulkRenameUtility/BulkRenameUtility.csproj \
        --configuration Release --runtime linux-x64 --self-contained true \
        --output "$srcdir/publish"
}

package() {
    install -d "$pkgdir/opt/bulk-rename-utility" \
        "$pkgdir/usr/bin" \
        "$pkgdir/usr/share/applications" \
        "$pkgdir/usr/share/icons/hicolor/512x512/apps"
    cp -a "$srcdir/publish/." "$pkgdir/opt/bulk-rename-utility/"
    printf '%s\n' '#!/bin/sh' 'exec /opt/bulk-rename-utility/BulkRenameUtility "$@"' \
        > "$pkgdir/usr/bin/BulkRenameUtility"
    chmod 0755 "$pkgdir/usr/bin/BulkRenameUtility" \
        "$pkgdir/opt/bulk-rename-utility/BulkRenameUtility"
    install -m 0644 "$srcdir/Bulk_Rename_Utility_Linux/packaging/bulk-rename-utility.desktop" \
        "$pkgdir/usr/share/applications/bulk-rename-utility.desktop"
    install -m 0644 "$srcdir/Bulk_Rename_Utility_Linux/src/BulkRenameUtility/Assets/bru-linux.png" \
        "$pkgdir/usr/share/icons/hicolor/512x512/apps/bulk-rename-utility.png"
}
